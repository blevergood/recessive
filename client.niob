// Generated by the Niobium FHE Application Design AI Assistant (FHEanna). — v0.13.0
// client.niob — client-side stages (hold the secret key)
//============================================================================
// Compiles to three binaries: keygen, encrypt, decrypt.
//
// IMPORTANT (trust boundary): the dosage matrix read here has ALREADY been
// imputed for missing calls and clipped to data/marker_bounds.csv [0, 2] by
// the client harness (harness/prepare_inputs.py) BEFORE it reaches encrypt.
// For this linear circuit the clip is data hygiene, not decode-safety: a
// weighted sum has no polynomial to overrun, so no dosage value can diverge.
// The server only ever sees ciphertext.
//============================================================================

use shared::*

scheme CKKS {
    security: 128-classic
    ring_dim: 65536
    key_dist: uniform_ternary
    key_switch: hybrid
    scaling: flexible_auto
    precision: 45 bits
    first_mod: 60 bits
    depth: 2
}

requires { add, mul }

// ============================================================================
// Stage 1: key generation — ALL keys written into the client home.
// run_test provisions the server home with the context + public/eval keys
// only (no secret key). This circuit uses no rotations, so no rotation keys
// are generated.
// ============================================================================

@client @stage("keygen")
fn generate_keys(inst: Instance) -> writes(CryptoParams)
{
    let keys = keygen()
    save_secret_key(keys.secret, keydir(inst) / "secret_key.bin")
    return CryptoParams {
        context: keys.context,
        public_key: keys.public,
        eval_mult_key: keys.eval_mult,
    }
}

// ============================================================================
// Stage 2: encrypt one slot-batch of participants (column-major packing).
// input_batch_<id>.txt: n_slots rows x n_markers dosages, already imputed +
// clipped to [0, 2], zero-padded to n_slots rows (a padding row scores 0).
// Each of the n_markers columns becomes one ciphertext holding that marker's
// dosage for every participant across the slots.
// ============================================================================

@client @stage("encrypt")
fn encrypt_markers(inst: Instance, batch_id: u32)
    -> reads(CryptoParams), writes(EncryptedMarkers)
{
    let params = load(CryptoParams, from: keydir(inst))
    // Path inlined (not via input_file()) so the ".txt" is visible at the
    // call site: load_matrix picks its text-vs-binary reader from the
    // literal argument string (alpha codegen behavior).
    let dataset = load_matrix<f64>(
        datadir(inst) / ("input_batch_" + str(batch_id) + ".txt"),
        inst.n_markers)
    assert rows(dataset) == inst.n_slots, "batch must be padded to n_slots rows"

    // Writes features_<m>.bin into upload/ (the compiler routes client wire
    // output to ctxtupdir); run_test moves them into upload/batch_<id>/,
    // which is where the server stage reads this batch from.
    return EncryptedMarkers {
        markers: for m in 0..inst.n_markers {
            let column = dataset[0..inst.n_slots, m]
            encrypt(params.public_key, column)
        }
    }
}

// ============================================================================
// Stage 3: decrypt one slot-batch of scores.
// Output: raw binary vec<f64> of polygenic risk scores, one per slot. The
// harness discards the padding slots; for interpretation the client may
// standardize the scores across the cohort in the clear (a monotone
// transform that does not change the risk ranking).
// ============================================================================

@client @stage("decrypt")
fn decrypt_scores(inst: Instance, batch_id: u32)
    -> reads(EncryptedScores),
       writes_plaintext(root() / ("scores_batch_" + str(batch_id) + ".bin"))
{
    let sk = load_secret_key(keydir(inst) / "secret_key.bin")
    let encrypted = load(EncryptedScores,
                         from: ctxtdowndir(inst) / ("cipher_scores_" + str(batch_id) + ".bin"))
    let scores = decrypt(sk, encrypted.scores)
    return scores
}
