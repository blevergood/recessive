// Generated by the Niobium FHE Application Design AI Assistant (FHEanna). — v0.13.0
// shared.niob — encrypted polygenic risk scoring (PRS) for a genomics biobank
//============================================================================
// Types, constants, and wire declarations shared by client and server.
//
// Design (frozen at the Stage 7 gate; see docs/design-narrative.md):
//   CKKS, ring 2^16, 128-bit classical, depth 2 (1 used + 1 spare),
//   scaling 45 bits, first modulus 60 bits.
//   Circuit: a polygenic risk score is a WEIGHTED SUM of a participant's
//     marker dosages. Column-major packing puts one ciphertext per marker,
//     32,768 participants across the slots, so the whole cohort is scored in
//     one pass:
//       score[p] = sum_m ( dosage[m][p] * weight[m] )      (ct x pt, 1 level)
//     Each product is a ciphertext (dosages) times a PUBLIC plaintext scalar
//     (the marker's published effect weight) — no ciphertext-ciphertext
//     multiply, no non-linearity, no rotations. Depth budget: 1 linear level,
//     depth 2 leaves 1 spare (pessimism rule). This is the shallowest useful
//     FHE circuit there is.
//
//   The weights are PUBLIC (published GWAS / PGS-Catalog effect sizes), so
//   they are a plaintext operand provisioned to the server — not a secret.
//   The genotype dosages are the sensitive data and are only ever seen
//   encrypted (see docs/protocol-threat-model.md).
//============================================================================

const N_MARKERS: u32 = 2000

enum Profile { Full }

struct Instance {
    profile: Profile,
    ring_dim: u32,
    n_slots: u32,
    n_markers: u32,
    depth: u32,
}

fn instance(profile: Profile) -> Instance {
    match profile {
        Full => Instance { profile, ring_dim: 65536, n_slots: 32768,
                           n_markers: N_MARKERS, depth: 2 },
    }
}

// ============================================================================
// Directory layout — all paths relative to the invoking home (root() = cwd).
// run_test / the demo set the working directory to the client home or the
// server home, so the same helpers resolve inside whichever home runs the
// binary. upload/ = client -> server ciphertexts; download/ = server ->
// client ciphertexts.
// ============================================================================

fn keydir(inst: Instance) -> path      { root() / "keys" }
fn datadir(inst: Instance) -> path     { root() / "data" }
fn modeldir(inst: Instance) -> path    { root() / "model" }
fn ctxtupdir(inst: Instance) -> path   { root() / "upload" }
fn ctxtdowndir(inst: Instance) -> path { root() / "download" }

fn upload_batch_dir(inst: Instance, batch_id: u32) -> path {
    ctxtupdir(inst) / ("batch_" + str(batch_id))
}

// ============================================================================
// Wire types (what crosses the trust boundary)
// ============================================================================

wire CryptoParams {
    context: CryptoContext,
    public_key: PublicKey,
    eval_mult_key: EvalMultKey,
}

wire EncryptedMarkers {
    markers: vec<enc<vec<f64>>>,   // one ciphertext per marker column
}

wire EncryptedScores {
    scores: enc<vec<f64>>,         // raw polygenic risk score per slot
}
