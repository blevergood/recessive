// Generated by the Niobium FHE Application Design AI Assistant (FHEanna). — v0.13.0
// server.niob — the encrypted scoring circuit (NO access to the secret key)
//============================================================================
// Compiles to one binary: score. Runs on the untrusted compute provider.
//
// Circuit (identical in every run mode — CPU, simulator, Fog):
//   score = sum_m ( markers[m] * weight[m] )      (ct x pt scalar, 1 level)
// One ciphertext-times-public-scalar multiply per marker, then free
// additions. No ciphertext-ciphertext multiply (so no relinearization on the
// critical path), no non-linearity, no rotations. The result is the raw
// polygenic risk score for every participant, one per slot.
//
// The weights are PUBLIC published effect sizes, provisioned to the server as
// plaintext data — not a secret in this engagement (see
// docs/protocol-threat-model.md).
//============================================================================

use shared::*

// The shared circuit: one function, called identically in every mode.
fn prs_circuit(inst: Instance, x: vec<enc<vec<f64>>>, W: mat<f64>)
    -> enc<vec<f64>>
{
    // Weighted sum across markers. Each x[m] is one marker's dosage ciphertext
    // (participants across slots); W[m][0] is that marker's public weight.
    let out: enc<vec<f64>> = zero()
    for m in 0..inst.n_markers {
        out = out + x[m] * W[m][0]
    }
    return out
}

@server @stage("score")
@hardware(cache_key: ["profile", "batch_id"])
fn score_batch(inst: Instance, batch_id: u32)
    -> reads(CryptoParams, EncryptedMarkers),
       writes(EncryptedScores[batch_id])
{
    let params = load(CryptoParams, from: keydir(inst))
    let em = load(EncryptedMarkers, from: upload_batch_dir(inst, batch_id))

    // Public per-marker weights, provisioned to the server home (n_markers x 1).
    let W = load_matrix<f64>(modeldir(inst) / "weights.txt", 1)

    let scores = prs_circuit(inst, em.markers, W)

    return EncryptedScores { scores }
}
